{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions de la fenêtre principale. Aucun plugin n'est exposé au JavaScript : le front ne peut appeler que les commandes de l'app listées ici.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-load-data-file",
    "allow-save-data-file",
    "allow-backup-data-file",
    "allow-open-url",
    "allow-open-folder",
    "allow-launch-application",
    "allow-execute-command",
    "allow-stop-process",
    "allow-pick-folder",
    "allow-pick-program"
  ]
}
